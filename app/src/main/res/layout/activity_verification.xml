<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#E2E8F0">

    <!-- ١ - صورة المسافر في الجهة اليسرى -->
    <ImageView
        android:id="@+id/img_passeport_yo"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:src="@android:drawable/ic_menu_myplaces"
        android:scaleType="fitCenter"
        android:background="#BFDBFE"
        android:padding="8dp"
        android:contentDescription="@string/passeport_yo" />

    <!-- ٢ - معلومات المسافر في الجهة اليمنى -->
    <RelativeLayout
        android:id="@+id/layout_infos_yo"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:background="#FFFFFF">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- ٣ - عنوان جواز السفر -->
                <TextView
                    android:id="@+id/txt_titre_yo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/titre_passeport_yo"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#1E3A8A"
                    android:gravity="center"
                    android:layout_marginBottom="20dp" />

                <!-- ٤ - اسم المسافر -->
                <TextView
                    android:id="@+id/txt_nom_yo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/nom_yo"
                    android:textColor="#0F172A"
                    android:textSize="16sp"
                    android:layout_marginBottom="14dp" />

                <!-- ٥ - سنة الميلاد -->
                <TextView
                    android:id="@+id/txt_naissance_yo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/naissance_yo"
                    android:textColor="#0F172A"
                    android:textSize="16sp"
                    android:layout_marginBottom="14dp" />

                <!-- ٦ - سنة الوجهة -->
                <TextView
                    android:id="@+id/txt_destination_yo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/destination_yo"
                    android:textColor="#0F172A"
                    android:textSize="16sp"
                    android:layout_marginBottom="14dp" />

                <!-- ٧ - العمر الزمني -->
                <TextView
                    android:id="@+id/txt_age_yo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/age_yo"
                    android:textColor="#1D4ED8"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="14dp" />

                <!-- ٨ - سبب السفر -->
                <TextView
                    android:id="@+id/txt_motif_yo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/motif_yo"
                    android:textColor="#0F172A"
                    android:textSize="16sp"
                    android:layout_marginBottom="20dp" />

                <!-- ٩ - نتيجة فحص المفارقة الزمنية -->
                <TextView
                    android:id="@+id/txt_risque_yo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/analyse_yo"
                    android:textColor="#92400E"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginBottom="20dp" />

                <!-- ١٠ - زر الموافقة على الرحلة -->
                <Button
                    android:id="@+id/btn_approuver_yo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/approuver_yo"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#15803D"
                    android:minHeight="56dp"
                    android:layout_marginBottom="12dp" />

                <!-- ١١ - زر رفض الرحلة -->
                <Button
                    android:id="@+id/btn_refuser_yo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/refuser_yo"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#B91C1C"
                    android:minHeight="56dp" />

            </LinearLayout>
        </ScrollView>
    </RelativeLayout>

</LinearLayout>
